# Supabase → Find Friends App → Connect → Direct → Session pooler → URI (copy it, don't retype)
# Username MUST include the project ref: postgres.<project-ref>
# If the password has special characters (@ # / ? %), percent-encode them
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@<pooler-host>.pooler.supabase.com:5432/postgres
API_PORT=4000
# Supabase Auth: the API checks sign-ins against this project's public keys (not a secret).
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for npm run db:demo-accounts and the verify:* scripts, which sign in as the demo accounts.
# The publishable key is public (Supabase -> Project Settings -> API Keys). Get DEMO_PASSWORD from the team.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
DEMO_PASSWORD=<ask-the-team>
# Profile photo uploads (Supabase Storage, public bucket "profile-photos"). Secret: never commit it.
# Supabase -> Project Settings -> API Keys -> service_role. Uses SUPABASE_URL above.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional: a Gemini API key (Google AI Studio -> Get API key) turns on the AI conversation starters
# in new match chats. Without it everything else works; new chats just have no suggested openers.
# Hosted, it goes in Render's Environment tab. Never commit a real key.
# GEMINI_API_KEY=<your-gemini-api-key>
# Hosted only: the client's origin(s), comma-separated. Leave unset locally (Vite proxies /api).
# CORS_ORIGIN=https://aura-is401.onrender.com
