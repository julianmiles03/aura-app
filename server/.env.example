# Supabase → Find Friends App → Connect → Direct → Session pooler → URI (copy it, don't retype)
# Username MUST include the project ref: postgres.<project-ref>
# If the password has special characters (@ # / ? %), percent-encode them
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@<pooler-host>.pooler.supabase.com:5432/postgres
API_PORT=4000
# Profile photo uploads (Supabase Storage, public bucket "profile-photos"): Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Hosted only: the client's origin(s), comma-separated. Leave unset locally (Vite proxies /api).
# CORS_ORIGIN=https://aura-is401.onrender.com
